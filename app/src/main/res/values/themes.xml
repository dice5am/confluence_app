<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Confluence" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:colorPrimary">#FF0EA5E9</item>
    </style>

    <!-- Cold-start splash: H1 at 108dp on void. postSplashScreenTheme hands off to Theme.Confluence. -->
    <style name="Theme.Confluence.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Confluence</item>
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
    </style>
</resources>
